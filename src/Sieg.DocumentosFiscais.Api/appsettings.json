{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "BancoDados": {
    "AplicarMigracoesAoIniciar": false
  },
  "RabbitMq": {
    "HostVirtual": "/",
    "NomeExchange": "documentos-fiscais",
    "NomeFila": "documentos-fiscais-processados",
    "ChaveRoteamento": "documento-fiscal.processado",
    "NomeExchangeRetentativa": "documentos-fiscais-retentativas",
    "IntervalosRetentativaSegundos": [5, 30, 120],
    "NomeExchangeFalhas": "documentos-fiscais-falhas",
    "NomeFilaFalhas": "documentos-fiscais-processados-falhas",
    "ChaveRoteamentoFalhas": "documento-fiscal.processado.falha",
    "LimiteMensagensNaoConfirmadas": 1,
    "QuantidadeLoteOutbox": 20,
    "IntervaloPublicacaoSegundos": 5
  },
  "AllowedHosts": "*"
}
