# Valores exclusivamente locais para uso com o docker-compose.
POSTGRES_DB=documentos_fiscais
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha
RABBITMQ_DEFAULT_USER=sieg
RABBITMQ_DEFAULT_PASS=troque-esta-senha
API_PORT=5119
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development

# A API e o processador usam a configuração padrão do .NET.
# Defina estas variáveis no ambiente em que cada aplicação será executada.
ConnectionStrings__PostgreSql=Host=localhost;Port=5432;Database=documentos_fiscais;Username=postgres;Password=troque-esta-senha
RabbitMq__Servidor=localhost
RabbitMq__Porta=5672
RabbitMq__Usuario=sieg
RabbitMq__Senha=troque-esta-senha
